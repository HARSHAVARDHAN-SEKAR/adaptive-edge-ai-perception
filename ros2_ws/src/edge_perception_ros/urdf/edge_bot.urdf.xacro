<?xml version="1.0"?>
<!-- edge_bot: minimal differential-drive robot with an RGB camera.
     Publishes /camera/image_raw via the gazebo_ros camera plugin so the
     perception node works without TurtleBot3. -->
<robot name="edge_bot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="body_l" value="0.30"/>
  <xacro:property name="body_w" value="0.22"/>
  <xacro:property name="body_h" value="0.10"/>
  <xacro:property name="wheel_r" value="0.05"/>
  <xacro:property name="wheel_w" value="0.03"/>

  <material name="body_gray"><color rgba="0.35 0.38 0.42 1"/></material>
  <material name="wheel_dark"><color rgba="0.12 0.12 0.12 1"/></material>
  <material name="cam_teal"><color rgba="0.20 0.60 0.55 1"/></material>

  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <geometry><box size="${body_l} ${body_w} ${body_h}"/></geometry>
      <material name="body_gray"/>
    </visual>
    <collision>
      <geometry><box size="${body_l} ${body_w} ${body_h}"/></geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.02"/>
    </inertial>
  </link>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_r + body_h/2}"/>
  </joint>

  <xacro:macro name="wheel" params="side y">
    <link name="wheel_${side}">
      <visual>
        <origin rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${wheel_r}" length="${wheel_w}"/></geometry>
        <material name="wheel_dark"/>
      </visual>
      <collision>
        <origin rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${wheel_r}" length="${wheel_w}"/></geometry>
      </collision>
      <inertial>
        <mass value="0.2"/>
        <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0003"/>
      </inertial>
    </link>
    <joint name="wheel_${side}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="wheel_${side}"/>
      <origin xyz="0 ${y} ${-body_h/2}"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>
  <xacro:wheel side="left"  y="${(body_w + wheel_w)/2}"/>
  <xacro:wheel side="right" y="${-(body_w + wheel_w)/2}"/>

  <link name="caster">
    <visual><geometry><sphere radius="${wheel_r/2}"/></geometry>
      <material name="wheel_dark"/></visual>
    <collision><geometry><sphere radius="${wheel_r/2}"/></geometry></collision>
    <inertial><mass value="0.05"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster"/>
    <origin xyz="${body_l/2 - wheel_r/2} 0 ${-body_h/2 - wheel_r/2}"/>
  </joint>

  <link name="camera_link">
    <visual><geometry><box size="0.03 0.08 0.03"/></geometry>
      <material name="cam_teal"/></visual>
    <inertial><mass value="0.05"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${body_l/2} 0 ${body_h/2 + 0.02}"/>
  </joint>
  <link name="camera_optical"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical"/>
    <origin rpy="-1.5708 0 -1.5708"/>
  </joint>

  <!-- Gazebo classic plugins (ros-humble-gazebo-ros-pkgs) -->
  <gazebo reference="camera_link">
    <sensor type="camera" name="rgb_camera">
      <update_rate>15.0</update_rate>
      <camera>
        <horizontal_fov>1.2</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.05</near><far>20.0</far></clip>
      </camera>
      <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
        <ros><remapping>~/image_raw:=/camera/image_raw</remapping></ros>
        <camera_name>camera</camera_name>
        <frame_name>camera_optical</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>
      <wheel_separation>${body_w + wheel_w}</wheel_separation>
      <wheel_diameter>${2*wheel_r}</wheel_diameter>
      <command_topic>cmd_vel</command_topic>
      <publish_odom>true</publish_odom>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>
  </gazebo>
</robot>
